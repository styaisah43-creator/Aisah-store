<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Toko Baju Dini</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #f9f9f9;
    }

    header {
      background-color: #222;
      color: white;
      padding: 15px;
      text-align: center;
    }

    .container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 15px;
      padding: 20px;
    }

    .card {
      background-color: white;
      border-radius: 10px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      text-align: center;
      padding: 15px;
      transition: 0.3s;
    }

    .card:hover {
      transform: scale(1.05);
    }

    .card img {
      width: 100%;
      border-radius: 10px;
    }

    .price {
      color: #e91e63;
      font-weight: bold;
      margin: 10px 0;
    }

    button {
      background-color: #e91e63;
      color: white;
      border: none;
      padding: 10px 15px;
      border-radius: 5px;
      cursor: pointer;
      transition: 0.3s;
    }

    button:hover {
      background-color: #c2185b;
    }

    footer {
      text-align: center;
      background-color: #222;
      color: white;
      padding: 10px;
      margin-top: 20px;
    }
  </style>
</head>
<body>

  <header>
    <h1>Toko Baju Dini 👚</h1>
    <p>Temukan gaya terbaikmu di sini!</p>
  </header>

  <div class="container">
    <div class="card">
      <img src="https://via.placeholder.com/200x250?text=Baju+1" alt="Baju 1">
      <h3>Baju Casual</h3>
      <p class="price">Rp 120.000</p>
      <button onclick="beli('Baju Casual')">Beli Sekarang</button>
    </div>

    <div class="card">
      <img src="https://via.placeholder.com/200x250?text=Baju+2" alt="Baju 2">
      <h3>Baju Kemeja</h3>
      <p class="price">Rp 150.000</p>
      <button onclick="beli('Baju Kemeja')">Beli Sekarang</button>
    </div>

    <div class="card">
      <img src="https://via.placeholder.com/200x250?text=Baju+3" alt="Baju 3">
      <h3>Baju Hoodie</h3>
      <p class="price">Rp 180.000</p>
      <button onclick="beli('Baju Hoodie')">Beli Sekarang</button>
    </div>
  </div>

  <footer>
    <p>&copy; 2025 Toko Baju aisah | Semua hak dilindungi</p>
  </footer>

  <script>
    function beli(nama) {
      alert('Kamu memilih ' + nama + '!\nSilakan lanjut ke WhatsApp untuk pemesanan.');
      window.location.href = "https://wa.me/6281234567890?text=Halo%20saya%20ingin%20beli%20" + encodeURIComponent(nama);
    }
  </script>

</body>
</html>
